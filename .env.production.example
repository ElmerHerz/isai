# ============================================================
# ISAI — Variables de entorno para el entorno de pruebas (Droplet)
# Copia como .env.production en el Droplet y completa con valores reales.
# NUNCA subas .env.production al repositorio.
# Ver docs/deploy-digitalocean-pruebas.md
# ============================================================

# --- Servidor ---
PORT=3000
NODE_ENV=production

# --- Base de datos (nombre de servicio "postgres" dentro de la red de Docker) ---
POSTGRES_PASSWORD=genera_un_password_fuerte_aqui
DATABASE_URL="postgresql://isai:genera_un_password_fuerte_aqui@postgres:5432/isai_pruebas"

# --- Redis (nombre de servicio "redis") ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT (genera secretos NUEVOS, nunca reutilices los de tu .env local) ---
# openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS / Caddy (mismo hostname que usas en sslip.io) ---
CORS_ORIGIN=https://164-90-123-45.sslip.io
SITE_ADDRESS=164-90-123-45.sslip.io
