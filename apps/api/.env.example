# ============================================================
# ISAI API — Variables de entorno
# Copia este archivo como .env y completa los valores reales
# NUNCA subas .env al repositorio
# ============================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de Datos PostgreSQL ---
# Formato: postgresql://usuario:contraseña@host:puerto/basededatos
# La base de desarrollo (isai_desa) corre en una instancia nativa de Postgres
# (no Docker) — ajusta usuario/contraseña/puerto a tu instalación local.
DATABASE_URL="postgresql://postgres:1234@localhost:5433/isai_desa"

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=   # Descomenta si tienes contraseña

# --- JWT ---
JWT_SECRET=cambia_esto_por_un_secreto_seguro_de_al_menos_64_caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_seguro_diferente
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
# URL del frontend (sin slash final)
CORS_ORIGIN=http://localhost:5173
